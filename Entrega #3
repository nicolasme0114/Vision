# ------------------------------------------------------------
# 2. CARGA Y PREPROCESAMIENTO
# ------------------------------------------------------------

def cargar_imagen(ruta):
    """
    Lee una radiografia en escala de grises y la redimensiona.
    Devuelve la imagen original y la imagen procesada.
    """

    original = cv2.imread(str(ruta), cv2.IMREAD_GRAYSCALE)

    if original is None:
        raise ValueError(f"No se pudo leer la imagen: {ruta}")

    procesada = cv2.resize(
        original,
        TAMANO,
        interpolation=cv2.INTER_AREA
    )

    return original, procesada


# ------------------------------------------------------------
# 3. VISTAS PARA INTERPRETAR LA IMAGEN
# ------------------------------------------------------------

def visualizar_imagen(original, gris, ruta="Radiografia"):
    """
    Muestra:
    1. Imagen original.
    2. Imagen redimensionada.
    3. Contraste mejorado con CLAHE.
    4. Bordes obtenidos mediante Canny.
    """

    # CLAHE permite visualizar mejor algunas variaciones locales
    # de contraste, pero no confirma la presencia de neumonia.
    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )
    contraste = clahe.apply(gris)

    # Bordes para explorar estructuras de intensidad.
    bordes = cv2.Canny(gris, 50, 150)

    imagenes = [
        (original, "1. Original"),
        (gris, "2. Escala de grises y tamano fijo"),
        (contraste, "3. Contraste CLAHE"),
        (bordes, "4. Bordes Canny")
    ]

    fig, ejes = plt.subplots(2, 2, figsize=(10, 9))

    for ax, (imagen, titulo) in zip(ejes.ravel(), imagenes):
        ax.imshow(imagen, cmap="gray", vmin=0, vmax=255)
        ax.set_title(titulo)
        ax.axis("off")

    fig.suptitle(str(ruta), fontsize=10)
    plt.tight_layout()
    plt.show()


# ------------------------------------------------------------
# 4. MODULO HOG: FORMA Y DISTRIBUCION DE BORDES
# ------------------------------------------------------------

def extraer_hog(gris):
    """
    Calcula un descriptor HOG.
    Resume orientaciones de gradientes en regiones locales.
    """

    imagen_float = gris.astype(np.float32) / 255.0

    caracteristicas = hog(
        imagen_float,
        orientations=9,
        pixels_per_cell=(16, 16),
        cells_per_block=(2, 2),
        block_norm="L2-Hys",
        visualize=False,
        feature_vector=True
    )

    return caracteristicas


# ------------------------------------------------------------
# 5. MODULO LBP: TEXTURA LOCAL
# ------------------------------------------------------------

def extraer_lbp(gris):
    """
    Calcula LBP y construye un histograma normalizado.
    El histograma resume la frecuencia de los patrones locales.
    """

    lbp = local_binary_pattern(
        gris,
        P=LBP_PUNTOS,
        R=LBP_RADIO,
        method="uniform"
    )

    # Para P=8 y el metodo uniform, usamos P+2 categorias.
    numero_bins = LBP_PUNTOS + 2

    histograma, _ = np.histogram(
        lbp.ravel(),
        bins=np.arange(numero_bins + 1),
        range=(0, numero_bins)
    )

    histograma = histograma.astype(np.float32)

    # Frecuencias relativas en lugar de cantidades absolutas.
    histograma /= (histograma.sum() + 1e-8)

    return histograma, lbp


# ------------------------------------------------------------
# 6. MODULO GLCM: ESTADISTICAS DE TEXTURA
# ------------------------------------------------------------

def extraer_glcm(gris):
    """
    Calcula estadisticas de textura a partir de una GLCM.
    Reduce los 256 niveles de gris a 32 niveles para el calculo.
    """

    gris_32 = (gris // 8).astype(np.uint8)

    matriz = graycomatrix(
        gris_32,
        distances=[1, 3],
        angles=[0, np.pi / 4, np.pi / 2, 3 * np.pi / 4],
        levels=32,
        symmetric=True,
        normed=True
    )

    propiedades = [
        "contrast",
        "dissimilarity",
        "homogeneity",
        "energy",
        "correlation",
        "ASM"
    ]

    valores = []

    for propiedad in propiedades:
        # Se promedian las distancias y orientaciones.
        resultado = graycoprops(matriz, propiedad)
        valores.append(float(np.mean(resultado)))

    return np.array(valores, dtype=np.float32), propiedades


# ------------------------------------------------------------
# 7. FUSION DE CARACTERISTICAS
# ------------------------------------------------------------

def extraer_caracteristicas(gris):
    """
    Combina HOG + LBP + GLCM en un unico vector numerico.
    Todavia no realiza ninguna prediccion.
    """

    hog_vector = extraer_hog(gris)
    lbp_hist, lbp_mapa = extraer_lbp(gris)
    glcm_vector, nombres_glcm = extraer_glcm(gris)

    vector = np.concatenate([
        hog_vector,
        lbp_hist,
        glcm_vector
    ])

    detalles = {
        "HOG": hog_vector,
        "LBP": lbp_hist,
        "LBP_mapa": lbp_mapa,
        "GLCM": glcm_vector,
        "nombres_GLCM": nombres_glcm
    }

    return vector, detalles


# ------------------------------------------------------------
# 8. VISUALIZACION DE CARACTERISTICAS
# ------------------------------------------------------------

def visualizar_caracteristicas(gris, detalles):
    """
    Muestra el mapa LBP y los valores de las propiedades GLCM.
    HOG se presenta como descriptor numerico.
    """

    fig, ejes = plt.subplots(1, 2, figsize=(11, 4))

    ejes[0].imshow(detalles["LBP_mapa"], cmap="gray")
    ejes[0].set_title("Mapa de patrones LBP")
    ejes[0].axis("off")

    nombres = detalles["nombres_GLCM"]
    valores = detalles["GLCM"]

    ejes[1].bar(nombres, valores)
    ejes[1].set_title("Propiedades GLCM")
    ejes[1].tick_params(axis="x", rotation=45)

    plt.tight_layout()
    plt.show()

    print("Cantidad de caracteristicas HOG:",
          len(detalles["HOG"]))
    print("Cantidad de caracteristicas LBP:",
          len(detalles["LBP"]))
    print("Valores GLCM:")

    for nombre, valor in zip(nombres, valores):
        print(f"  {nombre}: {valor:.5f}")


# ------------------------------------------------------------
# 9. IDENTIFICACION DE LA ETIQUETA DESDE LA CARPETA
# ------------------------------------------------------------

def obtener_etiqueta(ruta):
    """
    Reconoce NORMAL o PNEUMONIA a partir de las carpetas.
    No intenta diagnosticar la imagen.
    """

    partes = [parte.lower() for parte in ruta.parts]

    if "normal" in partes:
        return "NORMAL"

    if "pneumonia" in partes or "neumonia" in partes:
        return "PNEUMONIA"

    return None


# ------------------------------------------------------------
# 10. CONSTRUIR LA TABLA DE CARACTERISTICAS
# ------------------------------------------------------------

def construir_dataset(ruta_base):
    """
    Recorre las carpetas, procesa las imagenes y construye
    una tabla con una fila por imagen y una columna por
    caracteristica.

    Se omiten archivos sin etiqueta reconocible.
    """

    archivos = [
        ruta for ruta in ruta_base.rglob("*")
        if ruta.is_file() and ruta.suffix.lower() in EXTENSIONES
    ]

    filas = []

    for i, ruta in enumerate(archivos, start=1):
        etiqueta = obtener_etiqueta(ruta)

        if etiqueta is None:
            print(f"[SIN ETIQUETA] {ruta.name}")
            continue

        try:
            _, gris = cargar_imagen(ruta)
            vector, detalles = extraer_caracteristicas(gris)

            fila = {
                f"caracteristica_{j}": valor
                for j, valor in enumerate(vector)
            }

            fila["etiqueta"] = etiqueta
            fila["ruta"] = str(ruta)

            filas.append(fila)

            if i % 100 == 0:
                print(f"Procesadas {i} imagenes...")

        except (ValueError, cv2.error) as error:
            print(f"[ERROR] {ruta.name}: {error}")

    return pd.DataFrame(filas)

def preparar_datos(tabla):
    """
    Separa los descriptores (X) de las etiquetas (y).
    Elimina registros incompletos y etiquetas no reconocidas.
    """

    # Solo las columnas generadas por el extractor.
    columnas_caracteristicas = [
        columna for columna in tabla.columns
        if columna.startswith("caracteristica_")
    ]

    if not columnas_caracteristicas:
        raise ValueError(
            "No se encontraron columnas de características."
        )

    # X: matriz de características.
    X = tabla[columnas_caracteristicas].copy()

    # y: clase real de cada imagen.
    y = tabla["etiqueta"].copy()

    # Eliminar valores numéricos inválidos.
    X = X.replace([np.inf, -np.inf], np.nan)

    validos = X.notna().all(axis=1) & y.notna()

    X = X.loc[validos].astype(np.float64)
    y = y.loc[validos].astype(str).str.upper()

    # Solo admitimos las dos clases del proyecto.
    clases_validas = {"NORMAL", "PNEUMONIA"}
    mascara_clases = y.isin(clases_validas)

    X = X.loc[mascara_clases]
    y = y.loc[mascara_clases]

    if y.nunique() != 2:
        raise ValueError(
            "Se necesitan las dos clases: NORMAL y PNEUMONIA."
        )

    if y.value_counts().min() < 2:
        raise ValueError(
            "Se requieren al menos dos imágenes por clase "
            "para realizar una división estratificada."
        )

    print("Cantidad de imágenes válidas:", len(X))
    print("\nDistribución de las clases:")
    print(y.value_counts())

    return X, y
