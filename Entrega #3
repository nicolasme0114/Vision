def dividir_datos(X, y):
    """
    Reserva el 20 % de las imágenes para la evaluación final.
    Mantiene aproximadamente la proporción de las clases.
    """

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    print("\nTamaño de los conjuntos:")
    print("Entrenamiento:", X_train.shape)
    print("Prueba:", X_test.shape)

    print("\nClases en entrenamiento:")
    print(y_train.value_counts())

    print("\nClases en prueba:")
    print(y_test.value_counts())

    return X_train, X_test, y_train, y_test


# ============================================================
# MODULO DE CLASIFICACION Y COMPARACION
# ============================================================

def entrenar_modelos(X_train, y_train):
    """
    Entrena y ajusta k-NN, SVM y Random Forest.
    La validacion cruzada se realiza solo con entrenamiento.
    """

    # Cantidad de particiones adaptada a la clase minoritaria.
    min_clase = int(y_train.value_counts().min())
    n_splits = min(5, min_clase)

    if n_splits < 2:
        raise ValueError(
            "No hay suficientes muestras por clase para "
            "realizar validacion cruzada."
        )

    cv = StratifiedKFold(
        n_splits=n_splits,
        shuffle=True,
        random_state=42
    )

    # La normalizacion se ajusta dentro de cada particion
    # de entrenamiento durante la validacion cruzada.
    modelos = {
        "SVM": (
            Pipeline([
                ("escalador", StandardScaler()),
                ("clasificador", SVC(
                    class_weight="balanced"
                ))
            ]),
            {
                "clasificador__kernel": ["linear", "rbf"],
                "clasificador__C": [0.1, 1, 10]
            }
        ),

        "k-NN": (
            Pipeline([
                ("escalador", StandardScaler()),
                ("clasificador", KNeighborsClassifier())
            ]),
            {
                "clasificador__n_neighbors": [3, 5, 7],
                "clasificador__weights": ["uniform", "distance"]
            }
        ),

        "Random Forest": (
            Pipeline([
                ("escalador", StandardScaler()),
                ("clasificador", RandomForestClassifier(
                    class_weight="balanced",
                    random_state=42,
                    n_jobs=-1
                ))
            ]),
            {
                "clasificador__n_estimators": [100, 200],
                "clasificador__max_depth": [None, 20]
            }
        )
    }

    resultados = {}

    for nombre, (pipeline, parametros) in modelos.items():
        print(f"\nEntrenando modelo: {nombre}")

        busqueda = GridSearchCV(
            estimator=pipeline,
            param_grid=parametros,
            scoring="f1_macro",
            cv=cv,
            n_jobs=-1,
            refit=True,
            error_score="raise"
        )

        busqueda.fit(X_train, y_train)

        resultados[nombre] = {
            "modelo": busqueda.best_estimator_,
            "mejor_f1_cv": busqueda.best_score_,
            "mejores_parametros": busqueda.best_params_
        }

        print("Mejor F1 macro en validacion:",
              round(busqueda.best_score_, 4))
        print("Mejores parametros:",
              busqueda.best_params_)

    return resultados


# ============================================================
# EVALUACION SOBRE EL CONJUNTO DE PRUEBA
# ============================================================

def evaluar_modelos(resultados, X_test, y_test):
    """
    Evalua cada modelo sobre el conjunto de prueba.
    Genera metricas, informes y matrices de confusion.
    """

    filas_metricas = []

    for nombre, resultado in resultados.items():

        modelo = resultado["modelo"]
        predicciones = modelo.predict(X_test)

        # Para PNEUMONIA calculamos precision, recall y F1.
        precision_p = precision_score(
            y_test, predicciones,
            pos_label="PNEUMONIA",
            zero_division=0
        )

        recall_p = recall_score(
            y_test, predicciones,
            pos_label="PNEUMONIA",
            zero_division=0
        )

        f1_p = f1_score(
            y_test, predicciones,
            pos_label="PNEUMONIA",
            zero_division=0
        )

        accuracy = accuracy_score(y_test, predicciones)

        f1_macro = f1_score(
            y_test, predicciones,
            average="macro",
            zero_division=0
        )

        filas_metricas.append({
            "Modelo": nombre,
            "Accuracy": accuracy,
            "Precision_PNEUMONIA": precision_p,
            "Recall_PNEUMONIA": recall_p,
            "F1_PNEUMONIA": f1_p,
            "F1_macro": f1_macro,
            "F1_macro_CV": resultado["mejor_f1_cv"]
        })

        print("\n" + "=" * 55)
        print("MODELO:", nombre)
        print("=" * 55)

        print("\nInforme de clasificacion:")
        print(classification_report(
            y_test,
            predicciones,
            labels=["NORMAL", "PNEUMONIA"],
            zero_division=0
        ))

        matriz = confusion_matrix(
            y_test,
            predicciones,
            labels=["NORMAL", "PNEUMONIA"]
        )

        visualizador = ConfusionMatrixDisplay(
            confusion_matrix=matriz,
            display_labels=["NORMAL", "PNEUMONIA"]
        )

        visualizador.plot(cmap="Blues", values_format="d")
        plt.title(f"Matriz de confusion - {nombre}")
        plt.tight_layout()
        plt.show()

    tabla_resultados = pd.DataFrame(filas_metricas)
    tabla_resultados = tabla_resultados.sort_values(
        "F1_macro", ascending=False
    )

    print("\nCOMPARACION FINAL")
    print(tabla_resultados.to_string(index=False))

    return tabla_resultados

# ============================================================
# EJECUCION DEL ENTRENAMIENTO
# ============================================================

if __name__ == "__main__":

    # 1. Cargar la tabla de caracteristicas existente.
    archivo_csv = DATASET_DIR / "caracteristicas_clasicas.csv"

    if not archivo_csv.exists():
        raise FileNotFoundError(
            "No existe el CSV. Ejecuta primero el pipeline "
            "de extraccion de caracteristicas."
        )

    tabla = pd.read_csv(archivo_csv)

    # 2. Preparar X e y.
    X, y = preparar_datos(tabla)

    # 3. Separar entrenamiento y prueba.
    X_train, X_test, y_train, y_test = dividir_datos(X, y)

    # 4. Entrenar y ajustar los tres clasificadores.
    resultados = entrenar_modelos(X_train, y_train)

    # 5. Evaluar los modelos con datos no utilizados
    #    durante el entrenamiento ni el ajuste.
    metricas = evaluar_modelos(resultados, X_test, y_test)

    # 6. Guardar la tabla comparativa.
    archivo_metricas = DATASET_DIR / "metricas_modelos.csv"
    metricas.to_csv(archivo_metricas, index=False)

    # 7. Guardar el mejor modelo segun F1 macro de validacion.
    mejor_nombre = max(
        resultados,
        key=lambda nombre: resultados[nombre]["mejor_f1_cv"]
    )

    mejor_modelo = resultados[mejor_nombre]["modelo"]

    joblib.dump(
        mejor_modelo,
        DATASET_DIR / "modelo_clasico_neumonia.joblib"
    )

    print("\nMejor modelo segun validacion cruzada:",
          mejor_nombre)
    print("Modelo guardado correctamente.")
